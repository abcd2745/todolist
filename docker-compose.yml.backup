version: '3.8'

# =============================================================================
# 多Agent开发环境Docker Compose配置
# =============================================================================
# 架构：共享数据库 + Schema隔离 + 独立应用容器
# 启动：docker-compose --profile agent_1 up
# =============================================================================

services:
  # ===========================================================================
  # 共享数据库服务
  # ===========================================================================
  postgres:
    image: postgres:15-alpine
    container_name: todolist-db
    environment:
      POSTGRES_USER: dev
      POSTGRES_PASSWORD: dev_password
      POSTGRES_DB: todolist
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --locale=C.UTF-8"
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/init-schemas.sql:/docker-entrypoint-initdb.d/01-init-schemas.sql:ro
    networks:
      - todolist-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dev -d todolist"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 10s
    restart: unless-stopped

  # ===========================================================================
  # Agent 1 开发环境
  # ===========================================================================
  agent1-backend:
    profiles: ["agent_1"]
    build:
      context: ./backend
      dockerfile: Dockerfile.dev
    container_name: todolist-agent1-backend
    environment:
      # 数据库配置
      DATABASE_URL: postgresql://dev:dev_password@postgres:5432/todolist
      DB_SCHEMA: ${DB_SCHEMA:-agent_1}

      # 应用配置
      APP_NAME: "Gamified Todo - Agent 1"
      DEBUG: "true"
      PYTHONUNBUFFERED: 1

      # JWT配置
      SECRET_KEY: dev-secret-key-change-in-production
      ACCESS_TOKEN_EXPIRE_MINUTES: 15

      # AI配置（可选）
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}

    ports:
      - "8001:8000"
    volumes:
      # 代码挂载（实时同步）
      - ./backend:/app/code:cached

      # Python虚拟环境（独立）
      - agent1_backend_venv:/app/venv

      # 任务文件存储
      - ./data/tasks/agent1:/app/data/tasks

    working_dir: /app/code
    command: uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - todolist-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  agent1-frontend:
    profiles: ["agent_1"]
    build:
      context: ./frontend
      dockerfile: Dockerfile.dev
    container_name: todolist-agent1-frontend
    environment:
      # API地址
      VITE_API_URL: http://localhost:8001

      # 应用配置
      NODE_ENV: development
      VITE_APP_TITLE: "Gamified Todo - Agent 1"

    ports:
      - "5173:5173"
    volumes:
      # 代码挂载（实时同步）
      - ./frontend:/app/code:cached

      # Node modules（独立）
      - agent1_frontend_node:/app/code/node_modules

    working_dir: /app/code
    command: pnpm run dev --host 0.0.0.0
    networks:
      - todolist-network
    depends_on:
      - agent1-backend

  # ===========================================================================
  # Agent 2 开发环境
  # ===========================================================================
  agent2-backend:
    profiles: ["agent_2"]
    build:
      context: ./backend
      dockerfile: Dockerfile.dev
    container_name: todolist-agent2-backend
    environment:
      DATABASE_URL: postgresql://dev:dev_password@postgres:5432/todolist
      DB_SCHEMA: agent_2
      APP_NAME: "Gamified Todo - Agent 2"
      DEBUG: "true"
      PYTHONUNBUFFERED: 1
      SECRET_KEY: dev-secret-key-change-in-production
      ACCESS_TOKEN_EXPIRE_MINUTES: 15
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
    ports:
      - "8002:8000"
    volumes:
      - ./backend:/app/code:cached
      - agent2_backend_venv:/app/venv
      - ./data/tasks/agent2:/app/data/tasks
    working_dir: /app/code
    command: uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - todolist-network

  agent2-frontend:
    profiles: ["agent_2"]
    build:
      context: ./frontend
      dockerfile: Dockerfile.dev
    container_name: todolist-agent2-frontend
    environment:
      VITE_API_URL: http://localhost:8002
      NODE_ENV: development
      VITE_APP_TITLE: "Gamified Todo - Agent 2"
    ports:
      - "5174:5173"
    volumes:
      - ./frontend:/app/code:cached
      - agent2_frontend_node:/app/code/node_modules
    working_dir: /app/code
    command: pnpm run dev --host 0.0.0.0
    networks:
      - todolist-network
    depends_on:
      - agent2-backend

# =============================================================================
# Volumes
# =============================================================================
volumes:
  # 数据库持久化（共享）
  postgres_data:
    driver: local

  # Agent 1 独立volumes
  agent1_backend_venv:
    driver: local
  agent1_frontend_node:
    driver: local

  # Agent 2 独立volumes
  agent2_backend_venv:
    driver: local
  agent2_frontend_node:
    driver: local

# =============================================================================
# Networks
# =============================================================================
networks:
  todolist-network:
    driver: bridge
    name: todolist-dev